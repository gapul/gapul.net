---
// full.css = wght/wdth/slnt/opsz/GRAD を全部持つ版(latin サブセットのみ実際に読まれる)
import '@fontsource-variable/roboto-flex/full.css';
import '@fontsource-variable/noto-sans-jp';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { SITE } from '../lib/site';
import { STRINGS, type Locale } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
  altHref?: string; // 対になる言語版ページ(あればスイッチャーを出す)
  altIsTranslation?: boolean; // altHrefが同一内容の対訳ページなら hreflang も出す
}

const {
  title,
  lang = 'ja',
  description = STRINGS[lang].description,
  altHref,
  altIsTranslation = true,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url);
const path = Astro.url.pathname;
const home = lang === 'en' ? '/en/' : '/';
const works = lang === 'en' ? '/en/works/' : '/works/';
const blog = lang === 'en' ? '/en/blog/' : '/blog/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {altHref && altIsTranslation && (
      <>
        <link rel="alternate" hreflang={lang === 'ja' ? 'en' : 'ja'} href={new URL(altHref, SITE.url)} />
        <link rel="alternate" hreflang={lang} href={canonical} />
      </>
    )}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <!-- Mastodon/ActivityPub profile verification reads rel="me" here, same as a visible link would -->
    <link rel="me" href="https://social.gapul.net/@gapul" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={new URL('/og.jpg', SITE.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-dvh flex-col antialiased">
    <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-6 pt-8 text-base sm:px-12">
      <a href={home} class="display text-muted hover:text-paper">gapul.net</a>
      <nav class="display flex items-baseline gap-4 text-muted sm:gap-5">
        <a href={home} class:list={['capitalize hover:text-paper', path === home && 'text-paper']}>home</a>
        <a href={works} class:list={['capitalize hover:text-paper', path.startsWith(works) && 'text-paper']}>works</a>
        <a href={blog} class:list={['capitalize hover:text-paper', (path.startsWith('/blog') || path.startsWith('/en/blog')) && 'text-paper']}>blog</a>
        {altHref && (
          <a href={altHref} class="font-mono text-sm" aria-label={lang === 'ja' ? 'Switch to English' : '日本語に切り替え'}>
            <span class:list={[lang === 'ja' ? 'text-paper' : 'hover:text-paper']}>JP</span>
            <span> / </span>
            <span class:list={[lang === 'en' ? 'text-paper' : 'hover:text-paper']}>EN</span>
          </a>
        )}
      </nav>
    </header>
    <main class="flex flex-1 flex-col px-6 sm:px-12">
      <slot />
    </main>
  </body>
</html>
